{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "NodeNext",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "src/routes/meta.routes.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ],
  "extends": "expo/tsconfig.base"
}
