generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReceitaTipo {
  FIXA
  VARIAVEL
}

enum OrigemEvento {
  FINNITUS
  DISPOSITIVO
}

enum StatusFinanceiroEvento {
  NAO_ANALISADO
  SUSPEITO
  CONFIRMADO
  NAO_FINANCEIRO
}

enum Frequencia {
  UNICA
  SEMANAL
  QUINZENAL
  MENSAL
  ANUAL
}

enum CategoriaTipo {
  RECEITA
  DESPESA
}

enum StatusReceita {
  ATIVA
  INATIVA
}

enum DespesaTipo {
  FIXA
  VARIAVEL
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  BOLETO
}

enum StatusDespesa {
  PAGA
  PENDENTE
}

enum TipoEvento {
  RECEBIMENTO
  PAGAMENTO
  META
  OUTRO
}

enum PrioridadeMeta {
  BAIXA
  MEDIA
  ALTA
}

enum StatusMeta {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusDivida {
  ATIVA
  QUITADA
  ATRASADA
}

enum TipoImprevisto {
  PERDA_RENDA
  AUMENTO_DESPESA
  DESPESA_INESPERADA
  OUTRO
}

enum TipoMovimentacaoMeta {
  APORTE
  RETIRADA
}

enum TipoMeta {
  LONGO_PRAZO
  MENSAL
}

model Usuario {
  id_Usuario     Int       @id @default(autoincrement())
  tokenVersion   Int       @default(0)
  googleId       String?   @unique @db.VarChar(255)
  Unome          String    @db.VarChar(100)
  Usenha         String?   @db.VarChar(255)
  Uemail         String    @unique @db.VarChar(100)
  Utelefone      String?   @db.VarChar(15)
  Udata_nasc     DateTime? @db.Date
  Udata_cadastro DateTime
  UTipo          String

  CategoriaPersonalizada CategoriaPersonalizada[]
  Despesa                Despesa[]
  Evento                 Evento[]
  Imprevisto             Imprevisto[]
  Meta                   Meta[]
  Receita                Receita[]
  redefinicoes           RedefinicaoSenha[]
  Divida                 Divida[]
  ReservaFinanceira      ReservaFinanceira?
}

model RedefinicaoSenha {
  id_Redefinicao Int      @id @default(autoincrement())
  id_Usuario     Int
  codigo_hash    String   @db.VarChar(255)
  expira_em      DateTime
  usado          Boolean  @default(false)
  criado_em      DateTime @default(now())
  tentativas     Int      @default(0)
  verificado     Boolean  @default(false)

  Usuario Usuario @relation(fields: [id_Usuario], references: [id_Usuario], onDelete: Cascade)
}

model Receita {
  id_Receita                Int  @id @default(autoincrement())
  id_Usuario                Int
  id_Categoria              Int?
  id_CategoriaPersonalizada Int?

  descricao        String        @db.VarChar(255)
  valor            Decimal       @db.Decimal(10, 2)
  data_recebimento DateTime      @db.Date
  tipo             ReceitaTipo
  frequencia       Frequencia
  status           StatusReceita @default(ATIVA)
  observacao       String?       @db.VarChar(255)
  createdAt        DateTime      @default(now())

  Usuario                Usuario                 @relation(fields: [id_Usuario], references: [id_Usuario])
  Categoria              Categoria?              @relation(fields: [id_Categoria], references: [id_Categoria])
  CategoriaPersonalizada CategoriaPersonalizada? @relation(fields: [id_CategoriaPersonalizada], references: [id_CategoriaPersonalizada])

  Evento Evento?

  @@index([id_Usuario])
  @@index([id_Categoria])
  @@index([id_CategoriaPersonalizada])
  @@index([data_recebimento])
  @@index([id_Usuario, data_recebimento])
}

model Categoria {
  id_Categoria Int           @id @default(autoincrement())
  nome         String        @db.VarChar(100)
  tipo         CategoriaTipo

  Receita Receita[]
  Despesa Despesa[]
  Divida  Divida[]

  @@unique([nome, tipo])
}

model CategoriaPersonalizada {
  id_CategoriaPersonalizada Int           @id @default(autoincrement())
  id_Usuario                Int
  nome                      String        @db.VarChar(100)
  tipo                      CategoriaTipo

  Usuario Usuario @relation(fields: [id_Usuario], references: [id_Usuario])

  Receita Receita[]
  Despesa Despesa[]
  Divida  Divida[]

  @@unique([id_Usuario, nome, tipo])
  @@index([id_Usuario])
}

model Despesa {
  id_Despesa                Int  @id @default(autoincrement())
  id_Usuario                Int
  id_Categoria              Int?
  id_CategoriaPersonalizada Int?

  descricao       String          @db.VarChar(255)
  valor           Decimal         @db.Decimal(10, 2)
  data_vencimento DateTime        @db.Date
  data_pagamento  DateTime?       @db.Date
  tipo            DespesaTipo
  frequencia      Frequencia
  forma_pagamento FormaPagamento?
  status          StatusDespesa   @default(PENDENTE)
  observacao      String?         @db.VarChar(255)
  createdAt       DateTime        @default(now())

  Usuario                Usuario                 @relation(fields: [id_Usuario], references: [id_Usuario])
  Categoria              Categoria?              @relation(fields: [id_Categoria], references: [id_Categoria])
  CategoriaPersonalizada CategoriaPersonalizada? @relation(fields: [id_CategoriaPersonalizada], references: [id_CategoriaPersonalizada])

  Evento Evento?

  @@index([id_Usuario])
  @@index([id_Categoria])
  @@index([id_CategoriaPersonalizada])
  @@index([data_vencimento])
  @@index([data_pagamento])
  @@index([id_Usuario, data_vencimento])
}

model Imprevisto {
  id_Imprevisto Int @id @default(autoincrement())
  id_Usuario    Int

  Inome             String         @db.VarChar(100)
  tipo              TipoImprevisto
  Ivalor            Decimal        @db.Decimal(10, 2)
  Idata             DateTime       @db.Date
  duracao_meses     Int?
  solucao_escolhida String?        @db.VarChar(100)
  Idescricao        String?        @db.VarChar(255)

  Usuario Usuario @relation(fields: [id_Usuario], references: [id_Usuario])

  @@index([id_Usuario])
  @@index([Idata])
  @@index([id_Usuario, Idata])
}

model Meta {
  id_Meta    Int @id @default(autoincrement())
  id_Usuario Int

  Mnome           String         @db.VarChar(100)
  Mvalor_objetivo Decimal        @db.Decimal(10, 2)
  Mvalor_atual    Decimal        @default(0) @db.Decimal(10, 2)

  // Quanto o usuário pretende guardar periodicamente.
  // Pode ser usado futuramente para planejamento.
  Mvalor_periodo Decimal? @db.Decimal(10, 2)

  // LONGO_PRAZO ou MENSAL
  Mtipo TipoMeta

  // Para metas mensais.
  // Salvar o primeiro dia do mês, por exemplo:
  // Outubro/2026 -> 2026-10-01
  Mmes_referencia DateTime? @db.Date

  // Data limite opcional.
  Mprazo DateTime? @db.Date

  Mprioridade PrioridadeMeta @default(MEDIA)
  Mstatus     StatusMeta     @default(EM_ANDAMENTO)

  Mdata_criacao      DateTime  @default(now())
  Mdata_conclusao    DateTime?
  Mdata_cancelamento DateTime?

  Usuario Usuario @relation(fields: [id_Usuario], references: [id_Usuario], onDelete: Cascade)

  MovimentacaoMeta MovimentacaoMeta[]

  @@index([id_Usuario])
  @@index([Mprazo])
  @@index([Mmes_referencia])
  @@index([id_Usuario, Mstatus])
  @@index([id_Usuario, Mtipo])
  @@index([id_Usuario, Mmes_referencia])
}

model MovimentacaoMeta {
  id_Movimentacao Int @id @default(autoincrement())
  id_Meta         Int

  valor     Decimal              @db.Decimal(10, 2)
  tipo      TipoMovimentacaoMeta
  data      DateTime             @db.Date
  descricao String?              @db.VarChar(255)

  Meta Meta @relation(fields: [id_Meta], references: [id_Meta], onDelete: Cascade)

  @@index([id_Meta])
  @@index([data])
  @@index([id_Meta, data])
}

model Evento {
  id_Evento  Int @id @default(autoincrement())
  id_Usuario Int

  Enome      String  @db.VarChar(100)
  Edescricao String? @db.VarChar(255)

  data_inicio DateTime
  data_fim    DateTime?
  dia_inteiro Boolean   @default(false)

  tipo   TipoEvento   @default(OUTRO)
  origem OrigemEvento @default(FINNITUS)

  id_evento_externo String? @db.VarChar(255)

  status_financeiro StatusFinanceiroEvento @default(NAO_ANALISADO)
  valor_relacionado Decimal?               @db.Decimal(10, 2)

  id_Receita Int? @unique
  id_Despesa Int? @unique

  Usuario Usuario  @relation(fields: [id_Usuario], references: [id_Usuario], onDelete: Cascade)
  Receita Receita? @relation(fields: [id_Receita], references: [id_Receita], onDelete: SetNull)
  Despesa Despesa? @relation(fields: [id_Despesa], references: [id_Despesa], onDelete: SetNull)

  @@index([id_Usuario])
  @@index([data_inicio])
  @@index([id_Usuario, data_inicio])
  @@index([id_evento_externo])
  @@index([status_financeiro])
}

model Divida {
  id_Divida                 Int  @id @default(autoincrement())
  id_Usuario                Int
  id_Categoria              Int?
  id_CategoriaPersonalizada Int?

  nome                String       @db.VarChar(100)
  valor_total         Decimal      @db.Decimal(10, 2)
  valor_parcela       Decimal      @db.Decimal(10, 2)
  quantidade_parcelas Int
  parcelas_restantes  Int
  data_vencimento     DateTime     @db.Date
  taxa_juros          Decimal?     @db.Decimal(5, 2)
  status              StatusDivida @default(ATIVA)

  Usuario                Usuario                 @relation(fields: [id_Usuario], references: [id_Usuario])
  Categoria              Categoria?              @relation(fields: [id_Categoria], references: [id_Categoria])
  CategoriaPersonalizada CategoriaPersonalizada? @relation(fields: [id_CategoriaPersonalizada], references: [id_CategoriaPersonalizada])

  @@index([id_Usuario])
  @@index([id_Categoria])
  @@index([id_CategoriaPersonalizada])
  @@index([data_vencimento])
  @@index([id_Usuario, data_vencimento])
}

model ReservaFinanceira {
  id_Reserva     Int     @id @default(autoincrement())
  id_Usuario     Int     @unique
  valor_atual    Decimal @db.Decimal(10, 2)
  valor_desejado Decimal @db.Decimal(10, 2)
  objetivo       String? @db.VarChar(255)
  localizacao    String? @db.VarChar(255)

  Usuario Usuario @relation(fields: [id_Usuario], references: [id_Usuario])
}
