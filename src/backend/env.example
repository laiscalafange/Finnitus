/**
 * Teste de isolamento entre usuários. EXCLUSIVAMENTE num banco descartável.
 * 1) Configure o back-end para usar um banco de testes local.
 * 2) Inicie o servidor: npm run dev
 * 3) Rode: AUDIT_TEST_URL=http://127.0.0.1:3333 node --test tests/isolamento.api.test.mjs
 * Este script cria e exclui duas contas; não rodar contra produção.
 */
import { test } from 'node:test';
import assert from 'node:assert/strict';

const base = process.env.AUDIT_TEST_URL;
function urlIsLocal(value) {
  try { return ['127.0.0.1', 'localhost', '[::1]'].includes(new URL(value).hostname); } catch { return false; }
}

const run = Boolean(base && urlIsLocal(base));
const pwd = 'AuditoriaLocal@2026!';
const id = `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
const pessoas = [
  { email: `auditoria-a-${id}@example.test`, name: 'Pessoa de Teste A', password: pwd },
  { email: `auditoria-b-${id}@example.test`, name: 'Pessoa de Teste B', password: pwd },
];

async function api(path, method = 'GET', token, body) {
  const response = await fetch(new URL(path, base), {
    method,
    headers: { ...(token ? { Authorization: `Bearer ${token}` } : {}), ...(body ? { 'Content-Type': 'application/json' } : {}) },
    ...(body ? { body: JSON.stringify(body) } : {}),
  });
  const raw = await response.text();
  let data;
  try { data = JSON.parse(raw); } catch { data = raw; }
  return { status: response.status, data };
}

test('A não consegue consultar, alterar ou excluir recursos privados de B', { skip: !run ? 'Configure AUDIT_TEST_URL para um servidor de testes local' : false }, async () => {
  const tokens = [];
  try {
    for (const person of pessoas) {
      const registered = await api('/auth/register', 'POST', undefined, { ...person, maiorDeIdade: true, leuTermos: true });
      assert.equal(registered.status, 201, `Cadastro: ${JSON.stringify(registered.data)}`);
      const logged = await api('/auth/login', 'POST', undefined, { email: person.email, password: pwd });
      assert.equal(logged.status, 200, `Login: ${JSON.stringify(logged.data)}`);
      tokens.push(logged.data.token);
    }
    const [alice, bob] = tokens;
    const specs = [
      ['/categorias-personalizadas', { nome: 'Apenas B', tipo: 'DESPESA' }, 'id_CategoriaPersonalizada'],
      ['/receitas', { descricao: 'Receita B', valor: 100, data_recebimento: '2026-10-31', tipo: 'VARIAVEL', frequencia: 'UNICA', status: 'RECEBIDA' }, 'id_Receita'],
      ['/despesas', { descricao: 'Despesa B', valor: 20, data_vencimento: '2026-10-31', tipo: 'VARIAVEL', frequencia: 'UNICA', forma_pagamento: 'PIX', status: 'PENDENTE' }, 'id_Despesa'],
      ['/metas', { nome: 'Meta B', tipo: 'LONGO_PRAZO', valorObjetivo: 300 }, 'id_Meta'],
      ['/eventos', { Enome: 'Evento B', data_inicio: '2026-10-31T10:00:00.000Z' }, 'id_Evento'],
    ];
    for (const [route, body, idProp] of specs) {
      const created = await api(route, 'POST', bob, body);
      assert.equal(created.status, 201, `${route}: ${JSON.stringify(created.data)}`);
      const itemId = created.data[idProp];
      assert.ok(Number.isInteger(itemId), `ID ausente em ${route}`);
      const list = await api(route, 'GET', alice);
      assert.equal(list.status, 200);
      // Algumas rotas (metas) retornam objeto com coleção por tipo, não lista direta.
      assert.ok(!JSON.stringify(list.data).includes(`"${idProp}":${itemId}`), `Vazamento em ${route}`);
      for (const method of ['GET', 'PUT', 'DELETE']) {
        const result = await api(`${route}/${itemId}`, method, alice, method === 'PUT' ? { descricao: 'Tentativa invasiva', nome: 'Tentativa invasiva' } : undefined);
        assert.equal(result.status, 404, `${method} ${route}/${itemId}: ${JSON.stringify(result.data)}`);
      }
      const ownerRead = await api(`${route}/${itemId}`, 'GET', bob);
      assert.equal(ownerRead.status, 200, `B perdeu acesso ao próprio registro ${route}`);
    }
    // Referência de categoria personalizada de B não pode ser anexada a item de A.
    const foreignCategory = await api('/categorias-personalizadas', 'POST', bob, { nome: 'Categoria exclusiva B', tipo: 'RECEITA' });
    const invalid = await api('/receitas', 'POST', alice, {
      descricao: 'Não pode usar categoria alheia', valor: 2,
      id_CategoriaPersonalizada: foreignCategory.data.id_CategoriaPersonalizada,
      data_recebimento: '2026-10-31', tipo: 'VARIAVEL', frequencia: 'UNICA', status: 'PENDENTE',
    });
    assert.equal(invalid.status, 400, `FK de outro usuário aceita: ${JSON.stringify(invalid.data)}`);
  } finally {
    for (let i = 0; i < tokens.length; i++) {
      await api('/me', 'DELETE', tokens[i], { confirm: true, currentPassword: pwd }).catch(() => {});
    }
  }
});
