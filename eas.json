{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "release": {
      "env": {
        "ANDROID_PACKAGE": "com.finnitus.app",
        "EXPO_PUBLIC_API_URL": "https://finnitus-backend.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "162022351876-e3ngcdmsc25r41lni0k887j5fffalo49.apps.googleusercontent.com"
      }
    },
    "preview": {
      "extends": "release",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "release",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
